APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PAYMENT_URL=https://payment.sample.com
PAYMENT_APP_KEY=wqsakdnwljalhcxz
SOCKET_API_URL=http://localhost
SERVER_PORT=2000
DISCORD_WEBHOOK=
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=password

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Docker-specific (for this compose which only runs Laravel):
# The compose sets DB_HOST=${DOCKER_DB_HOST:-host.docker.internal} etc in container env.
# For DB in different prepared container (e.g. hostname "mysql-service" on network "docker_general_resource_default"):
#   DOCKER_DB_HOST=mysql-service
#   DB_NETWORK=docker_general_resource_default   # retrieved from .env; compose uses ${DB_NETWORK} for the external-db network
# See docker-compose.yml (external-db) and deploy.sh (auto-connect fallback).
DOCKER_DB_HOST=mysql-service
DB_NETWORK=docker_general_resource_default
DOCKER_REDIS_HOST=redis
# REDIS_NETWORK=the-redis-network-name (set if Redis also in separate container on its network)
REDIS_NETWORK=docker_general_resource_default

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=Laravel_session
CACHE_PREFIX=Laravel_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
# For this project's docker (DB/Redis in other prepared container):
# Set DOCKER_REDIS_HOST=your-redis-container-name and REDIS_NETWORK=its-network
# (deploy.sh will auto `docker network connect` so the name is resolvable from the app container).
# Alternative: use host.docker.internal if port published.
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
