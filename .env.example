APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# IMPORTANT: In production set this to https to prevent mixed-content blocks on assets (CSS/JS)
# and for correct URLs. The nginx proxy will be https, but the app needs to know.
# APP_URL=https://payment.farivamed.com
PAYMENT_URL=https://payment.sample.com
PAYMENT_APP_KEY=wqsakdnwljalhcxz
SOCKET_API_URL=http://localhost
SERVER_PORT=2000
DISCORD_WEBHOOK=
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=password

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=deprecations
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Docker-specific remapping (completely optional).
# docker-compose.yml uses:
#   DB_HOST=${DOCKER_DB_HOST:-${DB_HOST:-127.0.0.1}}
#   REDIS_HOST=${DOCKER_REDIS_HOST:-${REDIS_HOST:-127.0.0.1}}
#
# Only set DOCKER_DB_HOST / DOCKER_REDIS_HOST when the value inside the container
# must be different from the normal DB_HOST / REDIS_HOST in this file:
#   - sibling containers: DOCKER_DB_HOST=mysql-service
#   - reach Docker host:   DOCKER_DB_HOST=host.docker.internal
#
# Leave them unset when DB and/or Redis live on completely separate servers
# (different machines). Your normal DB_HOST and REDIS_HOST will be used inside the container.
#
# DB_NETWORK / REDIS_NETWORK are only consumed by deploy.sh for `docker network connect`
# (when you need the app container on that network for container name resolution).
DOCKER_DB_HOST=mysql-service
# DB_NETWORK=docker_general_resource_default
DOCKER_REDIS_HOST=redis
# REDIS_NETWORK=docker_general_resource_default

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=Laravel_session
CACHE_PREFIX=Laravel_cache_

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT: "phpredis" (native ext, faster, recommended for prod/Octane) or "predis" (pure PHP).
# If omitted, auto-selects phpredis when the redis extension is loaded, else predis.
# REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
# DOCKER_REDIS_HOST (see top of this file) is the optional Docker-specific override.
# Only needed if you want a different value inside the container than the REDIS_HOST above.
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
